{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rakvor.example/schemas/item-custody.schema.json",
  "title": "Rakvor chain-of-custody record (per item)",
  "type": "object",
  "required": [
    "schema",
    "jurisdiction",
    "run_id",
    "evidence_id",
    "item",
    "hashes",
    "examiner",
    "operations",
    "transfers"
  ],
  "properties": {
    "schema": {
      "const": "rakvor.item-custody/1"
    },
    "jurisdiction": {
      "enum": [
        "co",
        "fr"
      ]
    },
    "run_id": {
      "type": "string"
    },
    "case_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_id": {
      "type": "string",
      "description": "The case registry id (E0001...) when the run is linked to a case folder, else <RUN-ID>-<NNNNN>."
    },
    "item": {
      "type": "object",
      "required": [
        "index",
        "path",
        "file_name",
        "size"
      ],
      "properties": {
        "index": {
          "type": "integer",
          "minimum": 1
        },
        "path": {
          "type": "string"
        },
        "file_name": {
          "type": "string"
        },
        "size": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "hashes": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "md5",
          "sha1",
          "sha256",
          "sha512",
          "sha3-256",
          "blake3"
        ]
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{32,128}$"
      },
      "maxProperties": 2
    },
    "examiner": {
      "type": "string"
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "tool",
          "version",
          "start_utc",
          "end_utc",
          "audit_first_seq",
          "audit_last_seq"
        ]
      }
    },
    "transfers": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "intake_utc": {
      "type": [
        "string",
        "null"
      ],
      "description": "Case folder only: when the item was registered at intake."
    }
  }
}
