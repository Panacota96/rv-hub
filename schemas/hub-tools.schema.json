{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rakvor.example/schemas/hub-tools.schema.json",
  "title": "RV Hub tool inventory (`rv-hub tools --json`)",
  "description": "The Rakvor tools found on a workstation, with their version, where they were found, the SHA-256 and signature status of each executable, and the inventory findings.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "hub",
    "generated_utc",
    "signature_check",
    "rakvor_root_sha256",
    "tools",
    "not_installed",
    "signature_counts",
    "session_log",
    "exit_code"
  ],
  "$defs": {
    "signature": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "signed_rakvor",
            "signed_other_root",
            "invalid",
            "unsigned",
            "not_checked"
          ]
        },
        "root_sha256": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "severity",
        "params"
      ],
      "properties": {
        "code": {
          "enum": [
            "TOOL_SIGNED_RAKVOR",
            "TOOL_SIGNED_OTHER_ROOT",
            "TOOL_SIGNATURE_INVALID",
            "TOOL_UNSIGNED"
          ]
        },
        "severity": {
          "enum": [
            "info",
            "low",
            "medium",
            "high"
          ]
        },
        "params": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "exe": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "signature",
            "finding"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9a-f]{64}$"
            },
            "signature": {
              "$ref": "#/$defs/signature"
            },
            "finding": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/finding"
                }
              ]
            }
          }
        }
      ]
    }
  },
  "properties": {
    "schema": {
      "const": "rakvor.hub-tools/1"
    },
    "hub": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "version"
      ],
      "properties": {
        "tool": {
          "const": "rv-hub"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "generated_utc": {
      "type": "string",
      "pattern": "Z$"
    },
    "signature_check": {
      "description": "authenticode_rakvor_root on Windows; not_available elsewhere (every status is then not_checked).",
      "enum": [
        "authenticode_rakvor_root",
        "not_available"
      ]
    },
    "rakvor_root_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "tool",
          "title",
          "version",
          "role",
          "main_verb",
          "dir",
          "sources",
          "describe_source",
          "describe_problem",
          "cli",
          "gui",
          "findings",
          "warnings"
        ],
        "properties": {
          "tool": {
            "type": "string",
            "pattern": "^rv-[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string"
          },
          "version": {
            "type": [
              "string",
              "null"
            ]
          },
          "role": {
            "enum": [
              "intake",
              "analysis",
              "conversion"
            ]
          },
          "main_verb": {
            "type": "string"
          },
          "dir": {
            "type": "string"
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "registry",
                "local_programs",
                "path",
                "user_folder"
              ]
            }
          },
          "describe_source": {
            "description": "describe: the executable's own describe --json; builtin: RV Hub's built-in table (version unknown).",
            "enum": [
              "describe",
              "builtin"
            ]
          },
          "describe_problem": {
            "type": [
              "string",
              "null"
            ]
          },
          "cli": {
            "$ref": "#/$defs/exe"
          },
          "gui": {
            "$ref": "#/$defs/exe"
          },
          "findings": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/finding"
            }
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "not_installed": {
      "description": "Known tools that were not found.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "signature_counts": {
      "description": "Executables per signature status.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "signed_rakvor",
        "signed_other_root",
        "invalid",
        "unsigned",
        "not_checked"
      ],
      "properties": {
        "signed_rakvor": {
          "type": "integer",
          "minimum": 0
        },
        "signed_other_root": {
          "type": "integer",
          "minimum": 0
        },
        "invalid": {
          "type": "integer",
          "minimum": 0
        },
        "unsigned": {
          "type": "integer",
          "minimum": 0
        },
        "not_checked": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "session_log": {
      "description": "The hub session log that recorded this call (tools_listed).",
      "type": [
        "string",
        "null"
      ]
    },
    "exit_code": {
      "description": "3 when any executable is signed under another root or has an invalid signature, else 0.",
      "enum": [
        0,
        3
      ]
    }
  }
}
