# LF everywhere so hashes of committed files and docs/usage-cli.md are identical on Windows and Linux.
* text=auto eol=lf
*.ps1 text eol=crlf
*.iss text eol=crlf
*.png binary
*.jpg binary
*.pdf binary
examples/sample/evidence/** binary
tests/golden/*.zip binary
# The sample case is hashed and hash-chained byte for byte: never convert its line endings.
examples/sample/case/** binary
